*.pem
*.key
*.p12
*.crt
*.jks
.env
.env.*
!.env.example
token
tokens.json
credentials.json
service-account*.json
*_rsa
*_ed25519
.netrc

# ── internal / not for public consumption ────────────────────────────────────
# This repo is PUBLIC. Internal planning artefacts live in the private repos that
# consume this SDK, never here.
tickets/
ticket/
_internal/
_private/
*_INTERNAL.md
*_PRIVATE.md
scratch/
notes/
TODO.local.md


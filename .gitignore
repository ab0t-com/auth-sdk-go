# ── database / dump files ────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sql.gz
*.dump
*.rdb
# Deliberately NOT ignoring *.sql outright: schema and migration files are
# legitimate source. Ignore the shapes that are always a dump.
*dump*.sql
*backup*.sql
*.sql.bak

